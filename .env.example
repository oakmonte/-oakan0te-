# --- Server ---
PORT=3000
UPLOAD_TMP_DIR=./tmp-uploads

# --- Redis (required by BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- SQLite job tracking db file ---
DB_PATH=./data/jobs.sqlite

# --- Shopify ---
# Custom app access token (Admin API). Needs write_products & write_files scopes.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-10
# Shopify enforces ~2 req/sec on REST, cost-based limits on GraphQL.
# Keep worker concurrency conservative and let the adapter's retry/backoff absorb 429s.
SHOPIFY_WORKER_CONCURRENCY=4

# --- Bumpa ---
# Bumpa's public API surface is limited/undocumented in places (see docs.bumpa.io).
# Contact Bumpa support for a merchant API key + confirm exact endpoint paths & payload
# shape before relying on this in production. Fill in once confirmed.
BUMPA_API_BASE_URL=https://api.bumpa.io
BUMPA_API_KEY=replace-me
BUMPA_WORKER_CONCURRENCY=4

# --- ShipBubble ---
# Bearer token auth. Sandbox keys are prefixed sb_sandbox_, live keys sb_prod_.
# Get one from your ShipBubble dashboard: https://app.shipbubble.com
SHIPBUBBLE_BASE_URL=https://api.shipbubble.com/v1
SHIPBUBBLE_API_KEY=sb_sandbox_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
