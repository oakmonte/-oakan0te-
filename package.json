{
  "name": "mass-media-upload",
  "version": "1.0.0",
  "description": "Bulk media (image/video) upload pipeline that pushes local files to Shopify and Bumpa product listings via queued, rate-limited workers.",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "worker": "node dist/workers/mediaWorker.js",
    "worker:dev": "tsx watch src/workers/mediaWorker.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "bullmq": "^5.12.0",
    "ioredis": "^5.4.1",
    "better-sqlite3": "^11.3.0",
    "axios": "^1.7.7",
    "form-data": "^4.0.0",
    "dotenv": "^16.4.5",
    "nanoid": "^3.3.7"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsx": "^4.19.0",
    "@types/node": "^20.14.15",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/better-sqlite3": "^7.6.11"
  }
}
